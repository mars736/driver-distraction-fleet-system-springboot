<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.FleetMapper">

    <select id="listEnabled" resultType="vo.auth.FleetOptionVO">
        SELECT id AS fleet_id, name AS fleet_name
        FROM fleet
        WHERE enabled = 1
        ORDER BY id
    </select>

    <select id="selectById" resultType="entity.Fleet">
        SELECT * FROM fleet WHERE id = #{id}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM fleet
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fleet (name, enabled, remark)
        VALUES (#{name}, #{enabled}, #{remark})
    </insert>

</mapper>
